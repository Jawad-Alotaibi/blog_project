{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
"scripts": {
  "build": "vite build",
  "dev": "vite",
  "dev:php": "php artisan serve",
  "dev:queue": "php artisan queue:listen --tries=1",
  "dev:all": "concurrently -c \"#93c5fd,#c4b5fd,#fb7185\" -n server,queue,vite \"npm:dev:php\" \"npm:dev:queue\" \"npm:dev\" --kill-others"
},
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.4"
    }
}
